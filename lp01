<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
<style>
  :root{
    --marca:#14161A;
    --marca-escura:#0d0e11;
    --marca-fraca:#e8e8e8;
    /* A COR DA MARCA QUANDO ELA VIRA TEXTO SOBRE O PAPEL.
       Num tema claro é a marca mesma. Num tema escuro a marca do
       cliente pode ser um azul-marinho: legível sobre branco e
       invisível sobre carvão. Foi o que aconteceu no site de um
       advogado — a linha "para quem é" sumia dentro do card escuro.
       Nos blocos que já nascem escuros (topo, números, história) o
       site sempre usou --marca-fraca; isto estende a mesma ideia ao
       resto da página quando o papel inteiro escurece. */
    /* Deixou de ser um "se escuro, clareia" e passou a ser medido:
       marca cinzenta sobre card cinzento passava no teste antigo e
       sumia na tela. Ver lib/site/contraste.ts. */
    --marca-texto:#e8e8e8;
    --tinta:#F59F00;
    /* AS TINTAS MEDIDAS — ver lib/site/contraste.ts.
       Toda superfície pintada com --marca ou --tinta lê a sua daqui,
       em vez de cravar branco e torcer para o fundo ser escuro. */
    --sobre-marca:#ffffff;
    --sobre-tinta:#221600;
    --realce-tinta:#08080a;
    /* O botão da chamada final é o inverso da faixa: fundo na tinta
       que se lê sobre a marca, texto na marca — a não ser que a marca
       não contraste com esse fundo, e aí cai na tinta legível. */
    --btn-invertido:#ffffff;
    --btn-invertido-texto:#14161A;
    --fundo:#0c0d10;--suave:#14161b;--cartao:#181a20;--texto:#f2f3f5;--apagado:#9aa0ab;--linha:#262a33;--raio:18px;
    --dock:78px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  /* MOBILE PRIMEIRO. Tudo fora de @media é a tela de 320–759px; o
     bloco min-width:760 restaura o desktop. O celular ganha o rodapé
     fixo (.dock) e o body reserva o espaço dele. */
  body{font-family:'Inter',system-ui,sans-serif;color:var(--texto);background:var(--fundo);line-height:1.6;font-size:16px;padding-bottom:var(--dock);overflow-x:clip}
  h1,h2,h3{font-family:'Archivo',system-ui,sans-serif;line-height:1.1;letter-spacing:-.025em;text-wrap:balance}
  img{max-width:100%;display:block}
  .wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 18px}
  .tag{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--marca-texto);margin-bottom:12px}
  .tag::before{content:"";width:18px;height:2px;border-radius:2px;background:var(--marca-texto);flex:0 0 auto}
  .intro{color:var(--apagado);max-width:680px;margin-top:12px;font-size:1rem;line-height:1.6;text-wrap:pretty}
  section{padding:60px 0}
  h2{font-size:clamp(1.8rem,7.4vw,2.3rem)}

  header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--fundo) 88%,transparent);backdrop-filter:blur(12px) saturate(1.2);-webkit-backdrop-filter:blur(12px) saturate(1.2);border-bottom:1px solid var(--linha)}
  .barra{display:flex;align-items:center;justify-content:space-between;gap:12px;height:60px}
  .marca{display:flex;align-items:center;gap:10px;min-width:0;text-decoration:none;flex:1 1 auto}
  /* Altura fixa e largura livre: logo horizontal ou quadrada cabe sem
     esmagar. object-fit:contain para nunca cortar a marca do cliente. */
  .logo-img{height:32px;width:auto;max-width:120px;object-fit:contain;flex:0 0 auto}
  .logo{font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;color:var(--texto);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;letter-spacing:-.01em}
  nav{display:none;gap:24px}
  nav a{color:var(--apagado);text-decoration:none;font-size:14px;font-weight:500}
  nav a:hover{color:var(--marca-texto)}
  header .btn{min-height:40px;padding:0 16px;font-size:13px;flex:0 0 auto;box-shadow:none}
  /* O botão carrega a cor escolhida pelo cliente, com um degradê leve e
     sombra na própria cor — é o que faz ele parecer clicável em vez de
     um retângulo chapado. 52px de altura: dedo, não cursor. */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
    background:linear-gradient(180deg,var(--marca),var(--marca-escura));
    color:var(--sobre-marca);text-decoration:none;font-weight:700;min-height:52px;padding:14px 24px;border-radius:999px;
    font-size:15px;letter-spacing:.01em;white-space:nowrap;transition:transform .2s,box-shadow .2s;
    box-shadow:0 12px 28px -12px var(--marca)}
  .btn:hover{transform:translateY(-2px);box-shadow:0 16px 32px -12px var(--marca)}
  .btn:active{transform:translateY(0) scale(.99)}
  .btn2{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.4);box-shadow:none;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  .btn2:hover{background:rgba(255,255,255,.22);box-shadow:none}
  .chamada .btn{background:var(--btn-invertido);color:var(--btn-invertido-texto);box-shadow:0 10px 26px -12px rgba(0,0,0,.5)}

  /* TOPO: no celular a foto ocupa a tela e o texto assenta na base,
     alinhado à esquerda — é como os sites de vitrine abrem. O véu
     escurece de baixo para cima para o título ler sobre qualquer foto. */
  .hero{position:relative;color:#fff;text-align:left;display:flex;align-items:flex-end;min-height:min(84svh,760px);padding:120px 0 40px}
  /* A COR FICA DEBAIXO DA FOTO, SEMPRE.
     Endereço de foto morre: o cliente apaga a imagem do Drive, o
     Google troca o link da foto do Maps, o site de onde ela veio sai
     do ar. Quando isso acontece com a capa, o topo virava um retângulo
     vazio com o fundo da página aparecendo — foi o "fundo cinza sem
     foto" relatado em 17/09/2026. Com a cor no mesmo atalho, a foto
     que não abre deixa para trás o topo em cor sólida, que é o mesmo
     resultado de quem nunca pôs foto nenhuma. */
  .hero::before{content:"";position:absolute;inset:0;background:var(--tinta) url('https://cdowco9uebrdby23.public.blob.vercel-storage.com/fotos/servicos-locais/7190889-1600.webp') 50% 50% / cover}
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.30) 0%,rgba(0,0,0,.28) 35%,rgba(0,0,0,.84) 100%)}
  .hero .wrap{position:relative;z-index:2}
  .hero .tag{color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:7px 12px 7px 10px;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);margin-bottom:16px}
  .hero .tag::before{width:6px;height:6px;border-radius:50%;background:var(--marca-fraca)}
  .hero h1{font-size:clamp(2.25rem,9.6vw,3.6rem);line-height:1.02;letter-spacing:-.035em;margin-bottom:14px;max-width:900px}
  .hero p.sub{font-size:1.02rem;line-height:1.55;max-width:36ch;margin:0 0 22px;opacity:.9;text-wrap:pretty}
  .acoes{display:flex;flex-direction:column;gap:10px}
  .acoes .btn{width:100%}
  .fatos{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .fatos span{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border:1px solid rgba(255,255,255,.2);border-radius:999px;background:rgba(255,255,255,.08);font-size:.8rem;font-weight:500;line-height:1.2}
  .fatos span::before{content:"✓";color:var(--marca-fraca);font-weight:800;font-size:.8rem}

  /* NÚMEROS: uma grade 2×2 com fios finos, cada valor grande na cor
     clara da marca. */
  .numeros{background:var(--tinta);color:var(--sobre-tinta);padding:0}
  /* Uma faixa só, os quatro lado a lado — também no celular (decisão
     do dono, 16/09). Valor em clamp para "+1.500" caber em 320px. */
  .grade-n{display:grid;grid-template-columns:repeat(4,1fr);gap:0;text-align:center}
  .n{padding:22px 4px 18px;border-left:1px solid rgba(255,255,255,.1)}
  .n:first-child{border-left:0}
  .n b{font-family:'Archivo',sans-serif;display:block;font-size:clamp(1.25rem,5.6vw,2.1rem);font-weight:800;line-height:1;letter-spacing:-.03em;color:var(--realce-tinta);font-variant-numeric:tabular-nums}
  .n span{display:block;margin-top:8px;font-size:.56rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;opacity:.62;line-height:1.25;text-wrap:balance}

  .grade{display:grid;gap:16px;grid-template-columns:1fr;margin-top:30px}
  .item{background:var(--cartao);border:1px solid var(--linha);border-radius:var(--raio);overflow:hidden;transition:.2s;box-shadow:0 14px 34px -26px rgba(0,0,0,.45)}
  .item:hover{transform:translateY(-3px);box-shadow:0 18px 44px -24px rgba(0,0,0,.45)}
  .item img{width:100%;height:212px;object-fit:cover}
  .item-txt{padding:18px 18px 22px}
  .item h3{font-size:1.2rem;margin-bottom:6px}
  .item .pq{color:var(--marca-texto);font-size:.86rem;font-weight:600;margin-bottom:8px;line-height:1.45}
  .item p{color:var(--apagado);font-size:.93rem;line-height:1.6}

  .dif{background:var(--suave)}
  .grade-d{display:grid;gap:12px;grid-template-columns:1fr;margin-top:30px;counter-reset:dif}
  .d{background:var(--cartao);border:1px solid var(--linha);border-radius:var(--raio);padding:22px 20px}
  .d::before{counter-increment:dif;content:counter(dif,decimal-leading-zero);display:block;font-size:.72rem;font-weight:700;letter-spacing:.16em;color:var(--marca-texto);margin-bottom:10px}
  .d h3{font-size:1.1rem;margin-bottom:6px}
  .d p{color:var(--apagado);font-size:.93rem;line-height:1.6}

  .grade-p{display:grid;gap:14px;grid-template-columns:1fr;margin-top:30px;counter-reset:passo}
  .p{position:relative;padding:4px 0 4px 56px}
  .p::before{counter-increment:passo;content:counter(passo);position:absolute;left:0;top:2px;width:40px;height:40px;border-radius:50%;background:var(--marca);color:var(--sobre-marca);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.95rem;font-family:'Archivo',sans-serif}
  .p h3{font-size:1.1rem;margin-bottom:5px}
  .p p{color:var(--apagado);font-size:.93rem;line-height:1.6}

  .grid-fotos{display:grid;gap:10px;grid-template-columns:repeat(2,1fr);margin-top:26px}
  .grid-fotos img{width:100%;height:150px;object-fit:cover;border-radius:14px}
  .grid-fotos img:first-child{grid-column:span 2;height:230px}

  .planos{background:var(--suave)}
  .grade-pl{display:grid;gap:14px;grid-template-columns:1fr;margin-top:30px}
  .pl{background:var(--cartao);border:1px solid var(--linha);border-radius:var(--raio);padding:24px 20px;display:flex;flex-direction:column}
  .pl h3{font-size:1.25rem;margin-bottom:8px;color:var(--marca-texto)}
  .pl .res{color:var(--apagado);font-size:.93rem;margin-bottom:16px;line-height:1.55}
  .pl ul{list-style:none;margin-bottom:20px}
  .pl li{color:var(--texto);font-size:.92rem;padding:9px 0 9px 24px;position:relative;border-top:1px solid var(--linha);line-height:1.45}
  .pl li:first-child{border-top:0}
  .pl li::before{content:"✓";position:absolute;left:0;top:9px;color:var(--marca-texto);font-weight:800}
  .btn-pl{margin-top:auto;width:100%}

  .faq{background:var(--suave)}
  .perguntas{max-width:760px;margin:26px auto 0;display:grid;gap:10px}
  details{background:var(--cartao);border:1px solid var(--linha);border-radius:var(--raio);padding:0 18px}
  summary{cursor:pointer;font-weight:600;font-size:1rem;list-style:none;min-height:56px;display:flex;align-items:center;justify-content:space-between;gap:14px;line-height:1.35}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";color:var(--marca-texto);font-weight:700;font-size:1.3rem;flex:0 0 auto}
  details[open] summary::after{content:"−"}
  details p{margin:-4px 0 18px;color:var(--apagado);font-size:.93rem;line-height:1.6}

  .historia{background:var(--tinta);color:var(--sobre-tinta)}
  .historia .tag{color:var(--realce-tinta)}
  .historia .tag::before{background:var(--marca-fraca)}
  .historia p{opacity:.84;max-width:760px;margin-top:14px;font-size:1.02rem;line-height:1.65}

  .grade-dep{display:grid;gap:14px;grid-template-columns:1fr;margin-top:30px}
  .dep{background:var(--cartao);border:1px solid var(--linha);border-radius:var(--raio);padding:22px 20px}
  .dep p{font-size:1.02rem;line-height:1.6;margin-bottom:16px}
  .dep b{display:block;font-size:.9rem}
  .dep span{color:var(--apagado);font-size:.8rem}

  .mapa{margin-top:22px;border-radius:var(--raio);overflow:hidden;border:1px solid var(--linha)}
  .mapa iframe{width:100%;height:260px;border:0;display:block}

  .estrelas{color:#f5a623;letter-spacing:2px;margin-bottom:10px;font-size:.95rem}
  .assina{display:flex;align-items:center;gap:10px}
  .ini{width:38px;height:38px;border-radius:50%;background:var(--marca);color:var(--sobre-marca);display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
  .dep em{display:block;font-style:normal;color:var(--apagado);font-size:.78rem}

  .chamada{background:var(--marca);color:var(--sobre-marca);text-align:center;padding:64px 0}
  .chamada h2{margin-bottom:10px}
  .chamada p{opacity:.9;margin-bottom:24px;text-wrap:pretty}
  .chamada .btn{background:var(--btn-invertido);color:var(--btn-invertido-texto);width:100%}

  .contato .cols{display:grid;gap:12px;grid-template-columns:1fr;margin-top:26px}
  .campo{border:1px solid var(--linha);border-radius:var(--raio);padding:18px 20px;background:var(--cartao)}
  .campo h3{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--apagado);margin-bottom:6px;font-family:'Inter',sans-serif;font-weight:700}
  .campo p,.campo a{color:var(--texto);font-size:1rem;text-decoration:none;font-weight:500}

  footer{background:var(--tinta);color:color-mix(in srgb,var(--sobre-tinta) 62%,transparent);text-align:center;padding:30px 0;font-size:.84rem}

  /* CONTATO SEMPRE À MÃO. No celular, uma barra fixa embaixo com o botão
     inteiro (safe-area do iPhone respeitada) no lugar da pílula
     flutuante, que cobria texto e botão dos cards. No desktop a pílula
     volta e a barra some. */
  .zap{display:none;position:fixed;right:18px;bottom:18px;z-index:30;background:#25d366;color:#fff;border-radius:999px;padding:14px 20px;font-weight:600;text-decoration:none;box-shadow:0 12px 30px -10px rgba(0,0,0,.5)}
  .dock{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;gap:10px;padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));background:color-mix(in srgb,var(--fundo) 90%,transparent);backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);border-top:1px solid var(--linha)}
  .dock .btn{flex:1 1 auto;min-height:50px}
  .dock .btn svg{width:18px;height:18px;flex:0 0 auto}

  @media(min-width:760px){
    body{padding-bottom:0}
    .dock{display:none}
    .zap{display:inline-flex}
    nav{display:flex}
    .logo{font-size:19px}
    .logo-img{height:40px;max-width:180px}
    .barra{height:68px}
    header .btn{min-height:44px;padding:0 22px;font-size:14px}
    section{padding:96px 0}
    h2{font-size:clamp(1.8rem,3.6vw,2.4rem)}
    .hero{text-align:center;display:block;min-height:0;padding:104px 0 88px}
    .hero::after{background:linear-gradient(180deg,rgba(0,0,0,.42),rgba(0,0,0,.78))}
    .hero h1{font-size:clamp(2.6rem,5.4vw,3.7rem);margin-inline:auto}
    .hero p.sub{font-size:1.15rem;max-width:660px;margin:0 auto 28px}
    .acoes{flex-direction:row;flex-wrap:wrap;justify-content:center;gap:12px}
    .acoes .btn{width:auto}
    .fatos{justify-content:center;margin-top:30px}
    .numeros{padding:48px 0}
    .grade-n{grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
    .n{padding:0;border:0!important}
    .n b{font-size:clamp(3.2rem,4vw,4.4rem)}
    .n span{margin-top:10px;font-size:.72rem;letter-spacing:.12em}
    .grade{grid-template-columns:repeat(3,1fr);gap:18px}
    .item img{height:200px}
    .grade-d{grid-template-columns:repeat(3,1fr);gap:16px}
    .grade-p{grid-template-columns:repeat(3,1fr);gap:22px}
    .p{padding:58px 0 0}
    .p::before{top:0}
    .grid-fotos{grid-template-columns:repeat(3,1fr);gap:12px}
    .grid-fotos img,.grid-fotos img:first-child{height:220px;grid-column:auto}
    .grade-dep{grid-template-columns:repeat(3,1fr);gap:16px}
    .grade-pl{grid-template-columns:repeat(3,1fr);gap:16px}
    .chamada{padding:96px 0}
    .chamada .btn{width:auto}
    .contato .cols{grid-template-columns:repeat(3,1fr);gap:16px}
    .mapa iframe{height:300px}
  }
  @media(max-width:359px){
    header .btn{padding:0 12px;font-size:12px}
    .hero h1{font-size:2.05rem}
  }

  mark.dst{background:none;color:var(--dst,var(--marca));font-weight:inherit}
  .hero mark.dst{color:var(--dst,var(--marca-fraca))}
  .midia{margin:26px auto 0;max-width:920px;border-radius:var(--raio);overflow:hidden;background:var(--suave)}
  .midia img,.midia video{width:100%;display:block}
  .midia-video{position:relative;aspect-ratio:16/9}
  .midia-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .midia figcaption{padding:10px 14px;font-size:.82rem;color:var(--apagado)}
  .midia + .grade,.midia + .grade-d,.midia + .grade-p,.midia + .grade-pl{margin-top:26px}
  .bloco-ctas{margin-top:26px;display:flex;flex-wrap:wrap;gap:12px}
  section[data-estilo~="centrado"] .wrap{text-align:center}
  section[data-estilo~="centrado"] .bloco-ctas{justify-content:center}
  section[data-estilo~="a-direita"] .wrap{text-align:right}
  section[data-estilo~="a-direita"] .bloco-ctas{justify-content:flex-end}
  /* "ESQUERDA" PRECISA DE REGRA PRÓPRIA, e essa é a parte que não é
     óbvia: no computador o motor já manda .hero com text-align:center.
     Enquanto "esquerda" era só a ausência de classe, clicar nela não
     mudava nada no computador — o alinhamento padrão do bloco vencia.
     Pedir para mover o texto e ver a tela imóvel é o defeito que esta
