<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2064%2064'%3E%3Crect%20width%3D'64'%20height%3D'64'%20rx%3D'14'%20fill%3D'%2314161A'%2F%3E%3Ctext%20x%3D'32'%20y%3D'44'%20font-size%3D'34'%20font-family%3D'Georgia%2Cserif'%20font-weight%3D'bold'%20fill%3D'%23fff'%20text-anchor%3D'middle'%3ES%3C%2Ftext%3E%3C%2Fsvg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
