/* Números que contam ao entrar na tela.
   ------------------------------------------------------------------
   Roda só quando o bloco aparece, uma vez, e apenas em valores que são
   número de verdade — "6h-22h" e "4,8" ficam como estão em vez de
   virarem uma contagem sem sentido.

   Quem pediu menos animação no sistema operacional vê o valor final
   direto: efeito bonito não vale tontura em ninguém. */
(function () {
  var reduzir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var alvos = document.querySelectorAll(".n b");
  if (!alvos.length || reduzir || !("IntersectionObserver" in window)) return;

  function anima(el) {
    var bruto = el.textContent.trim();
    /* ESTA EXPRESSÃO ESTAVA SEM AS BARRAS INVERTIDAS: era
       /^(d+)([^d]*)$/, que procura a LETRA "d" e nunca casa com um
       número. Resultado: os números nunca contaram, em nenhum site
       gerado até 08/09/2026. Achado ao construir o pacote de
       movimento, que tinha o mesmo trabalho para fazer.

       Agora aceita prefixo e decimal também — "4,8" e "+500" são o
       que aparece de verdade na faixa. */
    var casa = bruto.match(/^([^0-9]*)([0-9]+(?:[.,][0-9]+)?)(.*)$/);
    if (!casa) return;
    var prefixo = casa[1] || "";
    var corpo = casa[2];
    var sufixo = casa[3] || "";
    var virgula = corpo.indexOf(",") >= 0;
    var decimais = /[.,]/.test(corpo) ? corpo.split(/[.,]/)[1].length : 0;
    var fim = parseFloat(corpo.replace(",", "."));
    if (!isFinite(fim) || fim < 2) return;
    var inicio = null;
    var dur = 1100;
    function escrever(v) {
      var t = v.toFixed(decimais);
      if (virgula) t = t.replace(".", ",");
      el.textContent = prefixo + t + sufixo;
    }
    function passo(t) {
      if (!inicio) inicio = t;
      var f = Math.min((t - inicio) / dur, 1);
      escrever(fim * (1 - Math.pow(1 - f, 3)));
      if (f < 1) requestAnimationFrame(passo);
    }
    escrever(0);
    requestAnimationFrame(passo);
  }

  var obs = new IntersectionObserver(function (itens) {
    itens.forEach(function (i) {
      if (i.isIntersecting) {
        anima(i.target);
        obs.unobserve(i.target);
      }
    });
  }, { threshold: 0.4 });

  alvos.forEach(function (el) { obs.observe(el); });
})();
</script>
